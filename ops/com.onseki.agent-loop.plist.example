<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.onseki.agent-loop</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd '/Users/sentinellab/AgentOS/音符资产' &amp;&amp; node scripts/loop-headless.mjs --execute</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>2</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/private/tmp/onseki-agent-loop.out.log</string>
    <key>StandardErrorPath</key>
    <string>/private/tmp/onseki-agent-loop.err.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
