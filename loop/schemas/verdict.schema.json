{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onseki.local/schemas/verdict.schema.json",
  "title": "ONSEKI Validator Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "gap_id",
    "attempt_id",
    "contract_hash",
    "checks",
    "unexpected_changes",
    "confidence",
    "reason",
    "validated_at"
  ],
  "properties": {
    "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "gap_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "contract_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"] },
          "evidence": { "type": ["string", "null"] },
          "detail": { "type": "string" },
          "metric": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    },
    "unexpected_changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "validated_at": { "type": "string", "format": "date-time" }
  }
}
